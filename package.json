{
   "name": "Infirmière 68000 - Frontend",
   "version": "1.1.0",
   "private": true,
   "engines": {
      "node": ">=26.0.0"
   },
   "scripts": {
      "dev": "next dev",
      "build": "next build",
      "start": "next start",
      "dev:docker": "concurrently -k \"PORT=3005 node --watch server.js\" \"npx wait-on -t 10000 http://localhost:3005 && npx browser-sync start -c bs-config.docker.js\"",
      "docker:build": "docker compose -f docker-compose.yml build",
      "docker:push": "docker compose -f docker-compose.yml push",
      "docker:deploy": "docker compose -f docker-compose.yml build && docker compose -f docker-compose.yml push"
   },
   "dependencies": {
      "@radix-ui/react-slot": "^1.2.3",
      "@react-email/components": "^0.5.7",
      "@react-email/render": "^1.4.0",
      "@socialgouv/matomo-next": "^1.11.0",
      "@tailwindcss/typography": "^0.5.19",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "framer-motion": "^12.23.24",
      "lucide-react": "^0.546.0",
      "next": "^16.1.6",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-hook-form": "^7.65.0",
      "resend": "^6.2.2",
      "tailwind-merge": "^3.3.1"
   },
   "devDependencies": {
      "@tailwindcss/postcss": "^4",
      "tailwindcss": "^4",
      "tw-animate-css": "^1.4.0"
   }
}
